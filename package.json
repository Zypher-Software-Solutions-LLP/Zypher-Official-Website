    "audit": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@sanity/client": "8.6.2",
    "@sanity/vision": "6.14.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.5",
    "next-sanity": "13.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.28.1",
    "sanity": "6.14.0",
    "styled-components": "^6.5.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "29.0.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.8.0"
    },
    "@module-federation/dts-plugin": {
      "adm-zip": "0.6.1"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    }
